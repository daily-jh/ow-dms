# 정식 운영(infra/compose.prod.yaml)용 예시. 실제 값은 서버의 infra/.env에만 두고 커밋·공유하지 마십시오.
# infra/server-setup.sh가 처음 실행될 때 자동으로 만든다. 직접 만들 때는 서버에서 생성:
#   openssl rand -hex 24      (비밀번호류)
#   openssl rand -base64 32   (SESSION_SECRET, PII_ENCRYPTION_KEY)
OWDMS_DOMAIN=donation.example.or.kr
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SESSION_SECRET=
# 후원자 연락처·OTP 비밀키 암호화 키. 잃으면 암호화된 정보를 복구할 수 없다(백업 암호와 함께 서버 밖 안전한 곳에 보관)
PII_ENCRYPTION_KEY=
# 백업 파일 암호. 잃으면 백업을 열 수 없다(서버 밖 안전한 곳에 보관)
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3
