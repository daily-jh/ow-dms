{
  "name": "ow-dms",
  "private": true,
  "version": "0.1.0",
  "description": "범용 복지기관 후원금·후원품 관리 시스템 (OW-DMS) — 오픈소스",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "pnpm --filter @owdms/db run migrate",
    "db:seed": "pnpm --filter @owdms/db run seed",
    "db:reset": "pnpm --filter @owdms/db run reset",
    "dev:api": "pnpm --filter @owdms/api run dev",
    "dev:web": "pnpm --filter @owdms/web run dev",
    "dev:worker": "pnpm --filter @owdms/worker run dev"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "type": "module"
}
