# 비밀값 없는 개발용 예시입니다. 실제 값은 .env에 두고 커밋하지 마십시오.
# 앱 런타임 계정(비 superuser, BYPASSRLS 없음)
DATABASE_URL=postgres://owdms_app:owdms_app_dev@localhost:5432/owdms
# migration 전용 계정(테이블 owner)
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/owdms
# 개발용 세션 서명 키: 운영에서는 반드시 별도 비밀 저장소에서 주입
SESSION_SECRET=change-me-dev-only-32-bytes-minimum!!
# 합성 계정 개발 로그인. 운영에서는 false + OIDC(Keycloak/기관 IdP) 사용
DEV_LOGIN_ENABLED=true
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_PORT=3000
